/**
 * Generated by Shield Wizard for ZMK
 * Applies to part "left" with controller "nice_nano_v2"
 */

// pin control for spi0
// - SCK on D3
// - MOSI on D2
// - MISO on D2
&pinctrl {
    /* configuration for spi0 device, default state */
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };
    /* configuration for spi0 device, sleep state */
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};
&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    // Leave at Zephyr's 0xff default. ORC is clocked out for 7 of the 8 bytes
    // of every motion burst read, and MOSI/MISO share P0.17, so those bytes go
    // onto the wire the sensor is driving. 0x00 was tried because in this
    // part's protocol the address MSB is the write bit, making 0xff decode as
    // "write register 0x7f" - the page select for the bank holding RES_STEP.
    // It made reads garbage: driving the shared line low fights the sensor's
    // data, so deltas came back huge and the cursor went random. 0xff is what
    // lets the sensor win the line. Do not set this to 0x00.
    // overrun-character = <0x00>;
};

// devices on spi0

// CS pins for devices on spi0
&spi0 {
    cs-gpios = <&pro_micro 0 GPIO_ACTIVE_LOW>;
};

#include <zephyr/dt-bindings/input/input-event-codes.h>

&spi0 {
    input_device_left0: input_device_left0@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        // MOSI and MISO share P0.17 (3-wire SDIO), so the nRF drives the line
        // during every read's data phase while the sensor drives it too. 1MHz
        // was tried to buy timing margin on that contention and did NOT stop
        // the runtime RES_STEP corruption, so it is back at 2MHz rather than
        // paying double bus occupancy for nothing. See src/pmw3610_cpi_reassert.c.
        spi-max-frequency = <2000000>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        irq-gpios = <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        // Range 200-3200, step 200; a non-multiple is silently truncated, and
        // out of range aborts init. Kept above the sensitivity wanted so the
        // keymap can trim Y - scaling down avoids the quantization wobble that
        // scaling up produces on slow movement. Raising it also lowers the speed
        // at which the sensor's 12-bit delta registers wrap (see REST3 in
        // cosmos_keyboard_left.conf), so it is not a free knob.
        // Effective: X 1200, Y ~590 - the keymap trims Y to 7/10 on top of the
        // sensor's own ~0.7 raw gain gap between axes. Step 200 to retune.
        // Halved from 2200: that was propping up the counts REPORT_INTERVAL_MIN=8
        // was discarding (see cosmos_keyboard_left.conf), which no longer happens.
        cpi = <1200>;

        // No force-awake, deliberately. It is the only thing that enables the
        // driver's activity-state handler, which read-modify-writes PERFORMANCE
        // (0x11) using a read that never turns the sensor's SPI clock on. After
        // idle that clock is gated, so it can read garbage and write the garbage
        // run-rate bits back, or leave force-awake stuck on. Wake latency is
        // covered by the downshift tuning in cosmos_keyboard_left.conf instead.

        // Leave these off - orientation is done in the keymap by
        // &zip_xy_transform. The driver packs swap/invert into the same
        // unverified RES_STEP write as the CPI, so a failed write loses both.
        // invert-x;
        // invert-y;
        // swap-xy;
    };
};
