/**
 * Generated by Shield Wizard for ZMK
 * Applies to part "left" with controller "nice_nano_v2"
 */

// pin control for spi0
// - SCK on D3
// - MOSI on D2
// - MISO on D2
&pinctrl {
    /* configuration for spi0 device, default state */
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };
    /* configuration for spi0 device, sleep state */
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};
&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
};

// devices on spi0

// CS pins for devices on spi0
&spi0 {
    cs-gpios = <&pro_micro 0 GPIO_ACTIVE_LOW>;
};

#include <zephyr/dt-bindings/input/input-event-codes.h>

&spi0 {
    input_device_left0: input_device_left0@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        irq-gpios = <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        // Resolution. Range 200-3200 in steps of 200.
        cpi = <1400>;

        // Keeps the sensor in RUN mode while ZMK is active. Without it the
        // driver downshifts to REST1 after 128ms (40ms sampling), REST2 after
        // 5s (100ms) and REST3 after 17s (500ms), so the first movement after
        // a pause lags badly. Costs idle current on this battery-powered half.
        force-awake;

        // Orientation is handled in the keymap by &zip_xy_transform, NOT here.
        // Do not re-enable these. The driver packs swap/invert into bits 7-5
        // of the page-1 RES_STEP register (0x85) alongside the CPI bits, and
        // writes the whole thing through a bank-switch sequence it never
        // verifies. When that write does not stick, orientation and CPI are
        // lost together and the ball comes back mis-oriented and sluggish
        // until the next reboot. Correcting orientation downstream, in ZMK,
        // takes it out of that register's blast radius entirely.
        // invert-x;
        // invert-y;
        // swap-xy;
    };
};
