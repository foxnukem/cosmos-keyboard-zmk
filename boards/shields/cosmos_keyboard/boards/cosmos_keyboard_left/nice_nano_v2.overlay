/**
 * Generated by Shield Wizard for ZMK
 * Applies to part "left" with controller "nice_nano_v2"
 */

// pin control for spi0
// - SCK on D3
// - MOSI on D2
// - MISO on D2
&pinctrl {
    /* configuration for spi0 device, default state */
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };
    /* configuration for spi0 device, sleep state */
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};
&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
};

// devices on spi0

// CS pins for devices on spi0
&spi0 {
    cs-gpios = <&pro_micro 0 GPIO_ACTIVE_LOW>;
};

#include <zephyr/dt-bindings/input/input-event-codes.h>

&spi0 {
    input_device_left0: input_device_left0@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        irq-gpios = <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        // Range 200-3200, step 200; a non-multiple is silently truncated, and
        // out of range aborts init. Kept above the sensitivity wanted so the
        // keymap can trim Y - scaling down avoids the quantization wobble that
        // scaling up produces on slow movement. Raising it also lowers the speed
        // at which the sensor's 12-bit delta registers wrap (see REST3 in
        // cosmos_keyboard_left.conf), so it is not a free knob.
        // Effective: X 1800, Y 1200 (keymap trims Y to 2/3). Step 200 to retune.
        cpi = <1800>;

        // No force-awake, deliberately. It is the only thing that enables the
        // driver's activity-state handler, which read-modify-writes PERFORMANCE
        // (0x11) using a read that never turns the sensor's SPI clock on. After
        // idle that clock is gated, so it can read garbage and write the garbage
        // run-rate bits back, or leave force-awake stuck on. Wake latency is
        // covered by the downshift tuning in cosmos_keyboard_left.conf instead.

        // Leave these off - orientation is done in the keymap by
        // &zip_xy_transform. The driver packs swap/invert into the same
        // unverified RES_STEP write as the CPI, so a failed write loses both.
        // invert-x;
        // invert-y;
        // swap-xy;
    };
};
