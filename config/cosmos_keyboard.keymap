#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "Main";
            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3     &kp N4    &kp N5                              &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W      &kp E      &kp R     &kp T     &kp K_MUTE    &kp K_MUTE  &kp Y      &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S      &kp D      &kp F     &kp G                               &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X      &kp C      &kp V     &kp B                               &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp MINUS  &kp EQUAL                                                                   &kp LBKT   &kp RBKT
                              &kp SPACE  &mo 0     &kp LGUI                            &kp SPACE  &mo 0   &kp ENTER
                              &kp LCTRL  &kp LALT                                      &mo 0
            >;

            sensor-bindings = <&inc_dec_kp A B &inc_dec_kp C D &inc_dec_kp E F>;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans                                                    &trans  &trans
                        &trans  &trans  &trans                    &trans  &trans  &trans
                        &trans  &trans                            &trans
            >;

            label = "Nav";
        };
    };
};
