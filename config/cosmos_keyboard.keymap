#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Must match the node order under keymap {} - inserting a layer renumbers
// everything after it.

#define BASE        0
#define NAV         1
#define SYS         2
#define MOUSE       3  // thumb-key activated, owned by &mo
#define SNIPER      4  // raised from MOUSE_HOLD; slows the ball via the listener override

// Wheel clicks per encoder detent: 63 per click, since &msc emits
// speed * trigger-period-ms / 1000 and its period is 16ms. MOVE_Y is the
// vertical wheel, MOVE_X the horizontal one used on NAV. Step in units of 63
// to retune - 10 clicks vertical, 6 horizontal.

#define ENC_SCRL_UP   MOVE_Y(630)
#define ENC_SCRL_DOWN MOVE_Y(-630)
#define ENC_SCRL_RIGHT MOVE_X(378)
#define ENC_SCRL_LEFT  MOVE_X(-378)

/ {
    behaviors {
        // Mouse scroll on an encoder. tap-ms must exceed &msc's 16ms
        // trigger-period-ms, or the release cancels &msc's tick work before it
        // fires and nothing scrolls at all.

        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Both thumb layer keys together - the only way onto SYS.
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "MAIN";
            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3     &kp N4     &kp N5                              &kp N6     &kp N7      &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W      &kp E      &kp R      &kp T     &kp K_MUTE    &kp K_MUTE  &kp Y      &kp U       &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S      &kp D      &kp F      &kp G                               &kp H      &kp J       &kp K      &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X      &kp C      &kp V      &kp B                               &kp N      &kp M       &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp MINUS  &kp EQUAL                                                                        &kp LBKT   &kp RBKT
                              &mo NAV    &kp SPACE  &kp LGUI                            &kp SPACE  &mo MOUSE   &kp ENTER
                              &kp LCTRL  &kp LALT                                       &mo SYS
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp GRAVE  &kp F1      &kp F2     &kp F3      &kp F4    &kp F5                    &kp F6     &kp F7     &kp F8    &kp F9     &kp F10  &kp DEL
&trans     &kp F11     &kp F12    &trans      &trans    &trans  &trans    &trans  &kp PG_UP  &kp MINUS  &kp UP    &kp EQUAL  &trans   &trans
&trans     &kp LSHFT   &kp LCTRL  &kp LGUI    &kp LALT  &trans                    &kp PG_DN  &kp LEFT   &kp DOWN  &kp RIGHT  &trans   &trans
&trans     &kp C_PREV  &kp C_PP   &kp C_NEXT  &trans    &trans                    &kp HOME   &kp END    &kp INS   &trans     &trans   &trans
                       &trans     &trans                                                                &trans    &trans
                                  &trans      &trans    &trans                    &trans     &trans     &trans
                                  &trans      &trans                              &trans
            >;

            // Scroll encoder goes horizontal here, replacing MAIN's vertical
            // scroll rather than stacking with it.

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_msc ENC_SCRL_RIGHT ENC_SCRL_LEFT>;
        };

        sys {
            display-name = "SYS";
            bindings = <
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans           &trans           &trans           &kp KP_DIVIDE    &trans  &bt BT_CLR_ALL
&bt BT_CLR  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans        &trans        &trans    &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MULTIPLY  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS      &trans  &trans
                          &trans        &trans                                                                                        &kp KP_NUMBER_0  &kp KP_DOT
                                        &trans        &trans        &trans                          &trans           &trans           &trans
                                        &trans        &trans                                        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        // Held via &mo on the right thumb - the only way to mouse buttons now
        // that the trackball no longer raises a layer by itself.

        mouse {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &trans     &trans     &trans     &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &mkp MB4   &mkp MB5   &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &trans     &trans     &trans     &mo SNIPER   &trans
                &trans  &trans                                                          &trans     &trans
                        &trans  &trans  &trans                    &mkp LCLK  &trans     &mkp RCLK
                        &trans  &trans                            &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        // Exists only to be named by the &input_listener_left0 override below.
        // All &trans so the mouse buttons under it stay live; no
        // sensor-bindings, so the encoders fall through to MOUSE.

        sniper {
            display-name = "SNIPER";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans                                                    &trans  &trans
                        &trans  &trans  &trans                    &trans  &trans  &trans
                        &trans  &trans                            &trans
            >;
        };
    };
};

// The sensor is wired to the left half; this listener runs on the right.

&input_listener_left0 {
    // Orientation is corrected here rather than with the driver's invert-x, to
    // keep it out of the RES_STEP write that also carries the CPI.
    //
    // Sensor axes already line up with the ball: raw X carries left/right, raw Y
    // near/far. No XY_SWAP. Verified by rolling the ball and reading raw values,
    // which give ball-right -> Xs<0 and ball-away -> Ys<0, so X_INVERT alone
    // lands ball-right on cursor-right and ball-away on cursor-up.
    //
    // Do not re-derive this from a reading taken while the axes are misbehaving
    // - that fault presents as a swap and once sent us to a 90 degree rotation
    // that was wrong in normal use. Verify orientation only from a good state.
    //
    // The processor rewrites the event code before testing the invert flags, so
    // under XY_SWAP an invert names the DESTINATION axis. Xs/Ys raw:
    //   none      -> X=+Xs, Y=+Ys      XY_SWAP           -> X=+Ys, Y=+Xs
    //   X_INVERT  -> X=-Xs, Y=+Ys      XY_SWAP|X_INVERT  -> X=-Ys, Y=+Xs
    //   Y_INVERT  -> X=+Xs, Y=-Ys      XY_SWAP|Y_INVERT  -> X=+Ys, Y=-Xs
    // HID Y is positive-down, so "clockwise" is not a usable spec here.
    //
    // No axis scaler: the target is 1:1, so a ball roll at 45 degrees sends the
    // cursor at 45 degrees. The &zip_y_scaler 7 10 that used to sit here aimed
    // at ~2:1 for a wide screen, which costs that property.
    //
    // Unverified: a previously measured raw Ys/Xs ~0.7 would leave ~1.43:1
    // rather than 1:1. That number predates the RES_STEP fix and may be an
    // artifact of measuring by hand. To settle it, roll the ball one full
    // revolution per axis on the trackball debug build and compare summed raw
    // counts - one revolution is the same surface distance either way.
    // If the gap is real, trim X down with &zip_x_scaler 7 10 and raise cpi to
    // compensate. Do NOT scale an axis up: 1c7fac5 found that amplifies
    // quantization into a 1,2,1,2 px wobble on slow movement.

    input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>;

    // Sniper mode. Not done by dropping cpi: pmw3610_cpi_reassert.c writes it
    // back 300ms after motion stops, and the sensor is on the peripheral with no
    // split channel to carry a sensor attribute from this half.
    //
    // process-next is required - without it the listener returns after this
    // override and the base X_INVERT is skipped, so the cursor goes left while
    // the key is held. The scaler then runs before the transform, which is safe
    // only because the transform is a pure negation with no XY_SWAP.
    //
    // Retune with the divisor alone, max 16. Never a multiplier: 1c7fac5 found
    // upscaling turns quantization into a 1,2,1,2 px wobble. track-remainders on
    // the stock scaler keeps sub-count movement from being dropped.

    sniper {
        layers = <SNIPER>;
        process-next;
        input-processors = <&zip_xy_scaler 1 2>;
    };

    // Trackball scrolls while SYS is held. Order is load-bearing: transform and
    // xy-scaler match X/Y only, scroll-scaler matches wheel only, so the mapper
    // splits the list in two. Listed after sniper so that holding both gives a
    // half-speed scroll rather than shadowing it.
    //
    // No process-next, unlike sniper: child processors run before the base list,
    // so the mapper would rewrite the codes out from under the base X_INVERT and
    // reverse horizontal scroll. Hence the repeated transform.
    //
    // Divisor split across two stages: the documented ceiling is 16 and cpi 2200
    // needs ~64 for 34 clicks/inch. Reusing &zip_xy_scaler is safe, remainder
    // state is per config entry. Retune with either stage.

    scroll {
        layers = <SYS>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_scaler 1 8>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 8>;
    };
};
