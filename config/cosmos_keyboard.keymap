#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Must match the node order under keymap {} - inserting a layer renumbers
// everything after it.
#define BASE        0
#define NAV         1
#define MOUSE       2  // trackball-activated, owned by zip_temp_layer
#define NUM         3
#define SYS         4
#define MOUSE_HOLD  5  // thumb-key activated, owned by &mo. Must stay separate
                       // from MOUSE: zip_temp_layer's timeout deactivates its
                       // layer unconditionally, which would drop a held layer.

// Wheel clicks per encoder detent: 63 per click, since &msc emits
// speed * trigger-period-ms / 1000 and its period is 16ms. MOVE_Y is the
// vertical wheel, MOVE_X the horizontal one used on NAV.
#define ENC_SCRL_UP   MOVE_Y(252)
#define ENC_SCRL_DOWN MOVE_Y(-252)
#define ENC_SCRL_RIGHT MOVE_X(189)
#define ENC_SCRL_LEFT  MOVE_X(-189)

// Expanded into both MOUSE and MOUSE_HOLD, which must stay identical. Edit
// here, never the layer nodes.
#define MOUSE_LAYER_BINDINGS                                                                      \
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &trans     &trans     &trans     &trans  &trans  \
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &mkp MB4   &mkp MB5   &trans  &trans  \
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans  \
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &trans     &trans     &trans     &trans  &trans  \
                &trans  &trans                                                          &trans     &trans             \
                        &trans  &trans  &trans                    &mkp LCLK  &trans     &mkp RCLK                     \
                        &trans  &trans                            &trans

#define MOUSE_LAYER_SENSORS                                                                         \
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,                                                    \
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,                                                    \
                <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>

/ {
    behaviors {
        // Mouse scroll on an encoder. tap-ms must exceed &msc's 16ms
        // trigger-period-ms, or the release cancels &msc's tick work before it
        // fires and nothing scrolls at all.
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Both thumb layer keys together - the only way onto SYS.
        sys_layer {
            bindings = <&mo SYS>;
            key-positions = <54 58>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "MAIN";
            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3     &kp N4     &kp N5                              &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W      &kp E      &kp R      &kp T     &kp K_MUTE    &kp K_MUTE  &kp Y      &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S      &kp D      &kp F      &kp G                               &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X      &kp C      &kp V      &kp B                               &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp MINUS  &kp EQUAL                                                                    &kp LBKT   &kp RBKT
                              &mo 1      &kp SPACE  &kp LGUI                            &kp SPACE  &mo 5   &kp ENTER
                              &kp LCTRL  &kp LALT                                       &mo 3
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp GRAVE  &kp F1      &kp F2     &kp F3      &kp F4    &kp F5                    &kp F6     &kp F7     &kp F8    &kp F9     &kp F10  &kp DEL
&trans     &kp F11     &kp F12    &trans      &trans    &trans  &trans    &trans  &kp PG_UP  &kp MINUS  &kp UP    &kp EQUAL  &trans   &trans
&trans     &kp LSHFT   &kp LCTRL  &kp LGUI    &kp LALT  &trans                    &kp PG_DN  &kp LEFT   &kp DOWN  &kp RIGHT  &trans   &trans
&trans     &kp C_PREV  &kp C_PP   &kp C_NEXT  &trans    &trans                    &kp HOME   &kp END    &kp INS   &trans     &trans   &trans
                       &trans     &trans                                                                &trans    &trans
                                  &trans      &trans    &trans                    &trans     &trans     &trans
                                  &trans      &trans                              &trans
            >;

            // Scroll encoder goes horizontal here, replacing MAIN's vertical
            // scroll rather than stacking with it.
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_msc ENC_SCRL_RIGHT ENC_SCRL_LEFT>;
        };

        // Raised automatically while the trackball moves, by zip_temp_layer.
        mouse {
            display-name = "MOUSE";
            bindings = <MOUSE_LAYER_BINDINGS>;
            sensor-bindings = MOUSE_LAYER_SENSORS;
        };

        num {
            display-name = "NUM";
            bindings = <
&trans  &trans  &kp KP_DIVIDE    &trans           &trans           &trans                             &trans           &trans           &trans           &kp KP_DIVIDE    &trans  &trans
&trans  &trans  &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans    &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MULTIPLY  &trans  &trans
&trans  &trans  &kp KP_SUBTRACT  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT  &trans  &trans
&trans  &trans  &kp KP_PLUS      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3                    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS      &trans  &trans
                &kp KP_NUMBER_0  &kp KP_NUMBER_0                                                                                        &kp KP_NUMBER_0  &kp KP_DOT
                                 &trans           &trans           &trans                             &trans           &trans           &trans
                                 &trans           &trans                                              &trans
            >;
        };

        sys {
            display-name = "SYS";
            bindings = <
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans      &bt BT_CLR_ALL
&bt BT_CLR  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans      &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans      &trans
&trans      &bootloader   &sys_reset    &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &sys_reset  &bootloader
                          &trans        &trans                                                                      &trans  &trans
                                        &trans        &trans        &trans                          &trans  &trans  &trans
                                        &trans        &trans                                        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        // Identical to `mouse`, but held via &mo instead. Same display name on
        // purpose - the OLED should read the same either way.
        mouse_hold {
            display-name = "MOUSE";
            bindings = <MOUSE_LAYER_BINDINGS>;
            sensor-bindings = MOUSE_LAYER_SENSORS;
        };
    };
};

// Any key press at a position NOT listed here drops the temp layer on keydown,
// so every button the MOUSE layer defines has to be listed or it deactivates
// the layer it needs and falls through to the layer below.
//
// Indices into the bindings array, rows of 12/14/12/12/4/6/3:
//   22, 23     - MB4, MB5              (row 2, under I and O)
//   33, 34, 35 - LCLK, MCLK, RCLK      (row 3, under J, K, L)
//   57, 58, 59 - LCLK, mo, RCLK        (right thumb cluster)
// Re-count these whenever the MOUSE layer gains or moves a button.
//
// require-prior-idle-ms must be non-zero or the keycode hook is not compiled in
// at all, and nothing stops ball jitter raising MOUSE while typing - which turns
// J into &mkp LCLK and warps the vim cursor to the pointer. 500ms because the
// timestamp only updates on real key events, not host auto-repeat, so a shorter
// guard expires during a held key or a pause between navigation bursts.
// Pointer movement is not gated by the layer, so this only delays the remap.
&zip_temp_layer {
    excluded-positions = <22 23 33 34 35 57 58 59>;
    require-prior-idle-ms = <500>;
};

// The sensor is wired to the left half; this listener runs on the right.
&input_listener_left0 {
    // Orientation is corrected here rather than with the driver's invert-x, to
    // keep it out of the RES_STEP write that also carries the CPI.
    //
    // The sensor is mounted 90 degrees off, so this is a rotation, not a mirror.
    // A rotation is XY_SWAP plus exactly one invert - XY_SWAP alone transposes.
    // The processor swaps the event's code first and only then tests the invert
    // flags, so an invert names the DESTINATION axis. Xs/Ys are raw sensor:
    //   XY_SWAP | X_INVERT -> X=-Ys, Y=+Xs   (this one, verified on hardware)
    //   XY_SWAP | Y_INVERT -> X=+Ys, Y=-Xs
    // Stated as algebra on purpose. Clockwise is ambiguous here: it does not say
    // whether the sensor or the data is being rotated, and HID Y is positive-
    // down, so handedness flips against the usual y-up convention.
    // The two options are 180 apart, so retune empirically: both axes backwards
    // means switch the invert; exactly one axis backwards means it is not a pure
    // rotation and the sensor is mirrored too - use XY_SWAP alone or both.
    //
    // cpi sets overall speed, this scaler sets the X:Y ratio - but the sensor's
    // raw axes are not equal gain. Measured Ys/Xs ~0.7, which is geometric, not
    // firmware: RES_STEP carries one CPI field covering both axes. The rotation
    // feeds screen X from the weak axis and screen Y from the strong one, so
    // the trim has to close that 0.7 gap before it buys any width at all:
    //   screenX : screenY = 0.7 * (d/m)
    // 1/2 gives 1.4:1, near the 1.43 that a wide screen wanted. Effective at
    // cpi 1800: X ~1260, Y ~900 - both down ~30% from pre-rotation, since the
    // weak axis now drives the axis that used to be driven by the strong one.
    //
    // Keep the multiplier small. scale_val() truncates event->value * mul to
    // int16_t, so a larger one shrinks the headroom before the sign wraps -
    // 16383 counts at mul 2, against 4681 at the 7 this replaced.
    //
    // Transform must precede the scaler: the swap rewrites the event code, so
    // ordered this way the trim lands on screen-vertical rather than sensor-Y.
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)>,
                       <&zip_y_scaler 1 2>,
                       <&zip_temp_layer MOUSE 200>;
};
