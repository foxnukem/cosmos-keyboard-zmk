#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define BASE   0
#define NAV    1
#define MOUSE  2
#define SYS    3

// Wheel clicks per encoder detent. &msc emits speed * trigger-period-ms / 1000
// per tick, so with its 16ms period the value is 63 per click: 63 = 1 click,
// 126 = 2, 189 = 3. Adjust to taste.
// (The stock SCRL_UP/SCRL_DOWN of 10 are tuned for a held key, not a detent.)
#define ENC_SCRL_UP   MOVE_Y(126)
#define ENC_SCRL_DOWN MOVE_Y(-126)

/ {
    behaviors {
        // Mouse scroll on an encoder. Wraps the stock &msc, which already has
        // acceleration disabled and an input listener attached.
        //
        // tap-ms must exceed &msc's 16ms trigger-period-ms: the sensor-rotate
        // behavior queues press -> wait tap-ms -> release, and the release
        // cancels &msc's tick work. At the default 5ms nothing scrolls at all.
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "MAIN";
            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3     &kp N4    &kp N5                              &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W      &kp E      &kp R     &kp T     &kp K_MUTE    &kp K_MUTE  &kp Y      &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S      &kp D      &kp F     &kp G                               &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X      &kp C      &kp V     &kp B                               &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp MINUS  &kp EQUAL                                                                   &kp LBKT   &kp RBKT
                              &kp SPACE  &mo NAV   &kp LGUI                            &kp SPACE  &mo NAV &kp ENTER
                              &kp LCTRL  &kp LALT                                      &mo SYS
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        // F-keys and numbers on the top row, arrows under the right home row,
        // mods mirrored on the left home row, media on the left bottom row.
        nav {
            display-name = "NAV";
            bindings = <
&kp GRAVE  &kp F1      &kp F2  &kp F3      &kp F4    &kp F5                    &kp F6     &kp F7      &kp F8    &kp F9     &kp F10  &kp DEL
&trans     &kp F11     &kp F12 &trans      &trans    &trans  &trans    &trans  &kp PG_UP  &kp MINUS   &kp UP    &kp EQUAL  &trans   &trans
&trans     &kp LSHFT   &kp LCTRL &kp LGUI  &kp LALT  &trans                    &kp PG_DN  &kp LEFT    &kp DOWN  &kp RIGHT  &trans   &trans
&trans     &kp C_PREV  &kp C_PP &kp C_NEXT &trans    &trans                    &kp HOME   &kp END     &kp INS   &trans     &trans   &trans
                       &trans  &trans                                                                 &trans    &trans
                               &trans      &trans    &trans                    &trans     &trans      &trans
                               &trans      &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        // Activated automatically while the trackball is moving, via the
        // zip_temp_layer input processor on &input_listener_left0 below.
        mouse {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &trans     &trans     &trans  &trans  &trans
                &trans  &trans                                                          &trans     &trans
                        &trans  &trans  &trans                    &mkp LCLK  &mkp MCLK  &mkp RCLK
                        &trans  &trans                            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };

        // Bluetooth, output routing and firmware entry. Held from the lower
        // right thumb key on the base layer.
        sys {
            display-name = "SYS";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
&trans      &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &bootloader   &sys_reset    &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &sys_reset  &bootloader
                          &trans        &trans                                                                      &trans  &trans
                                        &trans        &trans        &trans                          &trans  &trans  &trans
                                        &trans        &trans                                        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_msc ENC_SCRL_DOWN ENC_SCRL_UP>;
        };
    };
};

// Without this, pressing any key - including the mouse layer's own click keys -
// would immediately drop the layer. These are the right thumb cluster positions.
&zip_temp_layer {
    excluded-positions = <32 33 34 57 58 59>;
};

// Trackball behaviour. The listener runs on the right half (the central);
// the sensor itself is wired to the left and forwarded over the split link.
&input_listener_left0 {
    // Invert horizontal movement, then hold the mouse layer while the ball
    // moves, dropping it 200ms after it stops. Add INPUT_TRANSFORM_Y_INVERT
    // or INPUT_TRANSFORM_XY_SWAP to the same parameter (they are bit flags,
    // so combine with |) if the other axes ever need correcting.
    input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
                       <&zip_temp_layer MOUSE 200>;
};
